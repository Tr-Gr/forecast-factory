{
 "datasets": [
  {
   "name": "ds_counters",
   "displayName": "counters",
   "queryLines": [
    "SELECT (SELECT count(*) FROM fc_forecast_registry WHERE active) AS active_kpis,  (SELECT count(*) FROM fc_model_status WHERE champion_version IS NOT NULL) AS champion_models,  (SELECT sum(abs_error) / sum(y_actual) FROM fc_forecast_accuracy WHERE split = 'scored_vs_actual') AS scored_wape\n"
   ]
  },
  {
   "name": "ds_kpi_wape",
   "displayName": "kpi wape",
   "queryLines": [
    "SELECT kpi_id, split, sum(abs_error) / nullif(sum(y_actual), 0) AS wape FROM fc_forecast_accuracy WHERE split IN ('backtest', 'holdout') GROUP BY kpi_id, split\n"
   ]
  },
  {
   "name": "ds_status",
   "displayName": "model status",
   "queryLines": [
    "SELECT kpi_id, model_name, champion_version, champion_wape, challenger_version, challenger_wape, updated_at FROM fc_model_status ORDER BY kpi_id\n"
   ]
  },
  {
   "name": "ds_fva",
   "displayName": "forecast vs actual",
   "queryLines": [
    "SELECT kpi_id, series_key, ds, sum(y_actual) AS actual, sum(yhat) AS forecast, sum(yhat_lo) AS forecast_lo, sum(yhat_hi) AS forecast_hi FROM fc_forecast_accuracy WHERE split = 'scored_vs_actual' GROUP BY kpi_id, series_key, ds\n"
   ]
  },
  {
   "name": "ds_wape_version",
   "displayName": "wape by version",
   "queryLines": [
    "SELECT kpi_id, model_version, split, sum(abs_error) / nullif(sum(y_actual), 0) AS wape, count(*) AS points FROM fc_forecast_accuracy GROUP BY kpi_id, model_version, split ORDER BY kpi_id, model_version, split\n"
   ]
  },
  {
   "name": "ds_runs",
   "displayName": "run log",
   "queryLines": [
    "SELECT started_at, kpi_id, model_family, model_version, cutoff, round(wape_backtest, 4) AS wape_backtest, round(wape_holdout, 4) AS wape_holdout, promotion_decision, promotion_reason, run_name, run_id FROM fc_model_runs ORDER BY started_at DESC\n"
   ]
  }
 ],
